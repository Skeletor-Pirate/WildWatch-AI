# ==============================================================================
# WildWatch AI: Human-Wildlife Conflict Early Warning & Deterrent Network
# ==============================================================================

# AI Provider Configuration ('nvidia', 'nebius', or 'mock')
AI_PROVIDER="nvidia"

# 1. NVIDIA NIM & API Catalog (build.nvidia.com)
# Get your free developer API key from: https://build.nvidia.com/
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# NVIDIA Models:
# Flagship Reasoning LLM Agent:
NVIDIA_LLM_MODEL="nvidia/llama-3.1-nemotron-70b-instruct"

# Multimodal Vision Verification (VLM):
NVIDIA_VLM_MODEL="meta/llama-3.2-11b-vision-instruct"

# 2. Nebius Token Factory (Alternative Cloud Endpoint)
NEBIUS_API_KEY=""
NEBIUS_BASE_URL="https://api.studio.nebius.ai/v1/"
VLM_MODEL_ID="meta-llama/Llama-3.2-11B-Vision-Instruct"
LLM_MODEL_ID="meta-llama/Llama-3.1-70B-Instruct"

# 3. Free SMS Early Warning Gateway (for villagers & forest guards without smartphones)
# Textbelt public free tier provides 1 free SMS per day per IP with key 'textbelt'
SMS_ENABLED="true"
SMS_PROVIDER="textbelt"  # 'textbelt' (free public tier), 'fast2sms', 'twilio', or 'simulation'
SMS_API_KEY="textbelt"   # Official free key for textbelt.com
SMS_RECIPIENT_NUMBERS="+919876543210,+918765432109" # Comma-separated mobile numbers
SMS_SENDER_ID="WILDWATCH"

# 4. Telegram Alerts (Optional for live mobile alerts to forest rangers)
TELEGRAM_TOKEN=""
TELEGRAM_CHAT_ID=""

# 5. Web Search Context (Optional - Tavily)
TAVILY_API_KEY=""

# 6. Local Database Path
DB_PATH="wildwatch.db"

# 7. Edge Node Configuration
EDGE_ACCELERATION="auto"  # 'tensorrt', 'cuda', 'onnxruntime', 'cpu'
